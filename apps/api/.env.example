# App
NODE_ENV=development
PORT=3001

# Database (Update with your local PostgreSQL credentials)
# Default: postgresql://username:password@localhost:5432/database_name
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitmelegal_dev?schema=public"

# JWT
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-in-production
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Optional: Redis (not required for MVP)
# REDIS_URL=redis://localhost:6379

# Stripe (Test Mode - Week 6)
# These are dummy test keys - replace with your own Stripe test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_51DummyTestKeyForDevelopment123456789
STRIPE_PUBLISHABLE_KEY=pk_test_51DummyTestKeyForDevelopment123456789
STRIPE_WEBHOOK_SECRET=whsec_DummyWebhookSecretForDevelopment123
# Set to 'test' or 'live' (always use 'test' for development)
STRIPE_MODE=test

# Optional: AWS (for later phases)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=fitmelegal-dev-files
# AWS_REGION=eu-central-1

# Optional: Email (for later phases)
# RESEND_API_KEY=re_...
# FROM_EMAIL=noreply@fitmelegal.com

# Optional: AI (for later phases)
# OPENAI_API_KEY=sk-...
# DEEPL_API_KEY=...
