generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole
  userType      UserType? @map("user_type")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  phone         String?
  language      String    @default("en")
  timezone      String    @default("UTC")
  avatarUrl     String?   @map("avatar_url")
  emailVerified Boolean   @default(false) @map("email_verified")
  phoneVerified Boolean   @default(false) @map("phone_verified")
  kycStatus     KycStatus @default(PENDING) @map("kyc_status")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  advisor              Advisor?
  questions            Question[]
  answers              Answer[]
  reviews              Review[]
  orders               Order[]
  conversationsStarted Conversation[] @relation("ConversationInitiator")
  conversationsReceived Conversation[] @relation("ConversationReceiver")
  messages             Message[]
  subscriptions        Subscription[]
  organizedMeetings    VideoMeeting[] @relation("MeetingOrganizer")
  attendedMeetings     VideoMeeting[] @relation("MeetingAttendee")
  projects             Project[]
  documents            Document[]
  documentComments     DocumentComment[]
  documentTemplates    DocumentTemplate[]
  contractAnalyses     ContractAnalysis[]
  draftedDocuments     DraftedDocument[]
  adminLogs            AuditLog[]
  emailPreferences     EmailPreferences?
  emailLogs            EmailLog[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Advisor {
  id                    String             @id @default(uuid())
  userId                String             @unique @map("user_id")
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  advisorType           AdvisorType        @map("advisor_type")
  specializations       Json               @default("[]")
  languages             Json               @default("[]")
  licenseNumber         String?            @map("license_number")
  barAssociation        String?            @map("bar_association")
  yearsExperience       Int?               @map("years_experience")
  bio                   String?            @db.Text
  hourlyRate            Decimal?           @map("hourly_rate") @db.Decimal(10, 2)
  verificationLevel     VerificationLevel  @default(BASIC) @map("verification_level")
  verificationStatus    VerificationStatus @default(PENDING) @map("verification_status")
  verificationDocuments Json               @default("[]") @map("verification_documents")
  rating                Decimal            @default(0.0) @db.Decimal(3, 2)
  totalReviews          Int                @default(0) @map("total_reviews")
  totalEarnings         Decimal            @default(0.0) @map("total_earnings") @db.Decimal(12, 2)
  responseTimeMinutes   Int                @default(0) @map("response_time_minutes")
  acceptanceRate        Decimal            @default(0.0) @map("acceptance_rate") @db.Decimal(3, 2)
  featured              Boolean            @default(false)
  active                Boolean            @default(true)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  answers  Answer[]
  reviews  Review[]
  services Service[]

  @@index([advisorType])
  @@index([rating(sort: Desc)])
  @@index([featured])
  @@map("advisors")
}

model Question {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         QuestionCategory
  subcategory      String
  title            String
  description      String           @db.Text
  language         String
  budget           Decimal          @db.Decimal(10, 2)
  urgency          UrgencyLevel     @default(NORMAL)
  status           QuestionStatus   @default(OPEN)
  selectedAnswerId String?          @map("selected_answer_id")
  attachments      Json             @default("[]")
  views            Int              @default(0)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  answers Answer[]

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("questions")
}

model Answer {
  id          String       @id @default(uuid())
  questionId  String       @map("question_id")
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  advisorId   String       @map("advisor_id")
  advisor     Advisor      @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  content     String       @db.Text
  price       Decimal      @db.Decimal(10, 2)
  status      AnswerStatus @default(PENDING)
  attachments Json         @default("[]")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([questionId])
  @@index([advisorId])
  @@index([createdAt(sort: Desc)])
  @@map("answers")
}

model Review {
  id         String   @id @default(uuid())
  reviewerId String   @map("reviewer_id")
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  advisorId  String   @map("advisor_id")
  advisor    Advisor  @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  orderId    String?  @map("order_id") // Review for a completed order
  serviceId  String?  @map("service_id") // Service being reviewed
  questionId String?  @map("question_id") // Review for Q&A
  rating     Int // 1-5 stars
  comment    String?  @db.Text
  response   String?  @db.Text // Advisor's response to review
  helpful    Int      @default(0) // Number of users who found review helpful
  verified   Boolean  @default(false) // Verified purchase/service
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([advisorId])
  @@index([serviceId])
  @@index([rating])
  @@index([verified])
  @@index([createdAt(sort: Desc)])
  @@map("reviews")
}

model Service {
  id                String          @id @default(uuid())
  advisorId         String          @map("advisor_id")
  advisor           Advisor         @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  category          ServiceCategory
  subcategory       String
  title             String
  description       String          @db.Text
  price             Decimal         @db.Decimal(10, 2)
  currency          String          @default("EUR")
  deliveryTime      Int             @map("delivery_time") // in days
  revisions         Int             @default(0) // number of revisions included
  requirements      Json            @default("[]") // what client needs to provide
  deliverables      Json            @default("[]") // what advisor will deliver
  languages         Json            @default("[]")
  tags              Json            @default("[]")
  featured          Boolean         @default(false)
  active            Boolean         @default(true)
  totalOrders       Int             @default(0) @map("total_orders")
  totalRevenue      Decimal         @default(0.0) @map("total_revenue") @db.Decimal(12, 2)
  averageRating     Decimal         @default(0.0) @map("average_rating") @db.Decimal(3, 2)
  totalReviews      Int             @default(0) @map("total_reviews")
  viewCount         Int             @default(0) @map("view_count")
  lastOrderAt       DateTime?       @map("last_order_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  orders Order[]

  @@index([advisorId])
  @@index([category])
  @@index([active])
  @@index([featured])
  @@index([createdAt(sort: Desc)])
  @@map("services")
}

model Order {
  id                String      @id @default(uuid())
  serviceId         String      @map("service_id")
  service           Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  clientId          String      @map("client_id")
  client            User        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status            OrderStatus @default(PENDING)
  price             Decimal     @db.Decimal(10, 2)
  currency          String      @default("EUR")
  requirements      Json        @default("{}") // client's specific requirements
  deliverables      Json        @default("[]") // uploaded deliverables
  revisionCount     Int         @default(0) @map("revision_count")
  notes             String?     @db.Text
  dueDate           DateTime?   @map("due_date")
  completedAt       DateTime?   @map("completed_at")
  cancelledAt       DateTime?   @map("cancelled_at")
  cancellationBy    String?     @map("cancellation_by") // userId who cancelled
  cancellationReason String?    @map("cancellation_reason") @db.Text
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  paymentId         String?     @map("payment_id") // Stripe payment intent ID
  paidAt            DateTime?   @map("paid_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@index([serviceId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

model Conversation {
  id               String   @id @default(uuid())
  initiatorId      String   @map("initiator_id")
  initiator        User     @relation("ConversationInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiverId       String   @map("receiver_id")
  receiver         User     @relation("ConversationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  orderId          String?  @map("order_id") // Optional: conversation related to an order
  subject          String?
  lastMessageAt    DateTime? @map("last_message_at")
  initiatorUnread  Int      @default(0) @map("initiator_unread")
  receiverUnread   Int      @default(0) @map("receiver_unread")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  messages Message[]

  @@unique([initiatorId, receiverId, orderId])
  @@index([initiatorId])
  @@index([receiverId])
  @@index([orderId])
  @@index([lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id")
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  attachments    Json         @default("[]")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt(sort: Desc)])
  @@map("messages")
}

model SubscriptionPlan {
  id                      String   @id @default(uuid())
  name                    String   // "Basic", "Professional", "Business"
  slug                    String   @unique // "basic", "pro", "business"
  description             String?  @db.Text
  price                   Decimal  @db.Decimal(10, 2) // monthly price
  annualPrice             Decimal? @map("annual_price") @db.Decimal(10, 2) // annual price (discounted)
  currency                String   @default("EUR")

  // Feature limits
  questionsPerMonth       Int      @map("questions_per_month") // -1 for unlimited
  videoMinutesPerMonth    Int      @map("video_minutes_per_month") // -1 for unlimited
  documentReviewsPerMonth Int      @map("document_reviews_per_month") // -1 for unlimited
  maxProjects             Int      @map("max_projects") // -1 for unlimited

  // Feature flags
  prioritySupport         Boolean  @default(false) @map("priority_support")
  advancedAnalytics       Boolean  @default(false) @map("advanced_analytics")
  dedicatedAdvisor        Boolean  @default(false) @map("dedicated_advisor")
  customBranding          Boolean  @default(false) @map("custom_branding")
  apiAccess               Boolean  @default(false) @map("api_access")

  active                  Boolean  @default(true)
  sortOrder               Int      @default(0) @map("sort_order")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  subscriptions           Subscription[]

  @@index([active])
  @@index([sortOrder])
  @@map("subscription_plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @map("user_id")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String             @map("plan_id")
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  status               SubscriptionStatus @default(ACTIVE)
  billingPeriod        BillingPeriod      @default(MONTHLY) @map("billing_period")

  // Stripe integration
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripePriceId        String?            @map("stripe_price_id")

  // Billing dates
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt          DateTime?          @map("cancelled_at")

  // Trial
  trialStart           DateTime?          @map("trial_start")
  trialEnd             DateTime?          @map("trial_end")

  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  usageTracking        UsageTracking[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

model UsageTracking {
  id                  String       @id @default(uuid())
  subscriptionId      String       @map("subscription_id")
  subscription        Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId              String       @map("user_id")

  // Tracking period
  period              String       // "2025-01" (YYYY-MM format)

  // Usage counters
  questionsUsed       Int          @default(0) @map("questions_used")
  videoMinutesUsed    Int          @default(0) @map("video_minutes_used")
  documentReviewsUsed Int          @default(0) @map("document_reviews_used")

  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  @@unique([subscriptionId, period])
  @@index([userId])
  @@index([period])
  @@map("usage_tracking")
}

model VideoMeeting {
  id              String             @id @default(uuid())
  organizerId     String             @map("organizer_id")
  organizer       User               @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  attendeeId      String             @map("attendee_id")
  attendee        User               @relation("MeetingAttendee", fields: [attendeeId], references: [id], onDelete: Cascade)

  title           String
  description     String?            @db.Text

  // Scheduling
  scheduledStart  DateTime           @map("scheduled_start")
  scheduledEnd    DateTime           @map("scheduled_end")
  timezone        String             @default("UTC")

  // Meeting session
  status          MeetingStatus      @default(SCHEDULED)
  actualStart     DateTime?          @map("actual_start")
  actualEnd       DateTime?          @map("actual_end")
  durationMinutes Int?               @map("duration_minutes") // Actual duration

  // Video provider details (Daily.co, Agora, etc.)
  roomId          String?            @unique @map("room_id") // Provider room ID
  roomUrl         String?            @map("room_url") // Join URL
  providerData    Json?              @map("provider_data") @default("{}") // Additional provider info

  // Recording
  recordingEnabled Boolean           @default(false) @map("recording_enabled")
  recordingUrl    String?            @map("recording_url")
  recordingStatus RecordingStatus?   @map("recording_status")

  // Transcription
  transcriptUrl   String?            @map("transcript_url")
  transcriptText  String?            @map("transcript_text") @db.Text

  // Related entities
  orderId         String?            @map("order_id") // Optional: meeting for an order

  // Metadata
  notes           String?            @db.Text
  cancelledBy     String?            @map("cancelled_by") // User ID who cancelled
  cancellationReason String?         @map("cancellation_reason") @db.Text

  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([organizerId])
  @@index([attendeeId])
  @@index([scheduledStart])
  @@index([status])
  @@index([orderId])
  @@map("video_meetings")
}

model Project {
  id          String        @id @default(uuid())
  ownerId     String        @map("owner_id")
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  description String?       @db.Text

  // Access control
  members     Json          @default("[]") // Array of user IDs with access
  isPublic    Boolean       @default(false) @map("is_public")

  // Metadata
  orderId     String?       @map("order_id") // Optional: project for an order
  tags        Json          @default("[]")
  archived    Boolean       @default(false)

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  documents   Document[]

  @@index([ownerId])
  @@index([archived])
  @@index([orderId])
  @@map("projects")
}

model Document {
  id              String            @id @default(uuid())
  projectId       String            @map("project_id")
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId      String            @map("uploader_id")
  uploader        User              @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  name            String
  description     String?           @db.Text

  // File details
  fileUrl         String            @map("file_url") // S3 or storage URL
  fileSize        Int               @map("file_size") // In bytes
  mimeType        String            @map("mime_type")

  // Version control
  currentVersion  Int               @default(1) @map("current_version")

  // Metadata
  tags            Json              @default("[]")

  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  versions        DocumentVersion[]
  comments        DocumentComment[]

  @@index([projectId])
  @@index([uploaderId])
  @@index([createdAt(sort: Desc)])
  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String   @map("document_id")
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  version     Int
  fileUrl     String   @map("file_url")
  fileSize    Int      @map("file_size")
  changes     String?  @db.Text // Description of what changed

  uploadedBy  String   @map("uploaded_by") // User ID
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

model DocumentComment {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  content    String   @db.Text

  // Annotation position (for PDF/image annotations)
  page       Int?     // Page number (for PDFs)
  positionX  Float?   @map("position_x") // X coordinate
  positionY  Float?   @map("position_y") // Y coordinate

  // Thread support
  parentId   String?  @map("parent_id") // For replies

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([documentId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt(sort: Desc)])
  @@map("document_comments")
}

model DocumentTemplate {
  id              String              @id @default(uuid())
  creatorId       String              @map("creator_id")
  creator         User                @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  name            String
  description     String?             @db.Text
  category        TemplateCategory
  subcategory     String?

  // Template content with variables {{variable_name}}
  templateContent String              @map("template_content") @db.Text
  variables       Json                @default("[]") // Array of {name, type, description, required}

  // Marketplace
  isPublic        Boolean             @default(false) @map("is_public")
  price           Decimal?            @db.Decimal(10, 2) // null for free templates
  currency        String              @default("EUR")

  // Metadata
  tags            Json                @default("[]")
  language        String              @default("en")
  usageCount      Int                 @default(0) @map("usage_count")

  active          Boolean             @default(true)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  draftedDocuments DraftedDocument[]

  @@index([creatorId])
  @@index([category])
  @@index([isPublic])
  @@index([active])
  @@map("document_templates")
}

model ContractAnalysis {
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Source document
  documentId      String?            @map("document_id") // Optional: if analyzing saved document
  fileName        String             @map("file_name")
  fileUrl         String             @map("file_url")
  fileSize        Int                @map("file_size")
  mimeType        String             @map("mime_type")

  // Analysis status
  status          AnalysisStatus     @default(PENDING)
  errorMessage    String?            @map("error_message") @db.Text

  // AI analysis results
  summary         String?            @db.Text // High-level summary
  risks           Json?              @default("[]") // Array of identified risks
  keyTerms        Json?              @default("[]") // Extracted important clauses
  obligations     Json?              @default("[]") // Party obligations
  recommendations Json?              @default("[]") // AI recommendations
  fullAnalysis    Json?              @map("full_analysis") @default("{}") // Complete structured data

  // AI metadata
  aiModel         String?            @map("ai_model") // "gpt-4", "claude-3-opus", etc.
  tokensUsed      Int?               @map("tokens_used")
  processingTime  Int?               @map("processing_time") // milliseconds

  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("contract_analyses")
}

model DraftedDocument {
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional: if using a template
  templateId      String?            @map("template_id")
  template        DocumentTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  title           String
  description     String?            @db.Text

  // Generation
  userPrompt      String?            @map("user_prompt") @db.Text // If free-form generation
  variables       Json?              @default("{}") // If using template
  generatedContent String            @map("generated_content") @db.Text

  // Document status
  status          DraftStatus        @default(DRAFT)

  // AI metadata
  aiModel         String?            @map("ai_model")
  tokensUsed      Int?               @map("tokens_used")

  // Optional: save to document workspace
  projectId       String?            @map("project_id")
  documentId      String?            @map("document_id") // If saved as Document

  // Export
  exportedAt      DateTime?          @map("exported_at")
  exportFormat    String?            @map("export_format") // "pdf", "docx", etc.

  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([userId])
  @@index([templateId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("drafted_documents")
}

model AuditLog {
  id          String       @id @default(uuid())
  adminId     String       @map("admin_id")
  admin       User         @relation(fields: [adminId], references: [id], onDelete: Cascade)

  action      AdminAction  // APPROVE_ADVISOR, SUSPEND_USER, etc.
  entityType  String?      @map("entity_type") // "User", "Advisor", "Service", etc.
  entityId    String?      @map("entity_id") // ID of affected entity

  details     Json?        @default("{}") // Additional details about the action
  ipAddress   String?      @map("ip_address")
  userAgent   String?      @map("user_agent")

  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([adminId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model EmailPreferences {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notification preferences
  orderUpdates           Boolean  @default(true) @map("order_updates")
  questionAnswers        Boolean  @default(true) @map("question_answers")
  newMessages            Boolean  @default(true) @map("new_messages")
  meetingReminders       Boolean  @default(true) @map("meeting_reminders")
  subscriptionUpdates    Boolean  @default(true) @map("subscription_updates")
  marketingEmails        Boolean  @default(false) @map("marketing_emails")
  weeklyDigest           Boolean  @default(false) @map("weekly_digest")
  advisorApplications    Boolean  @default(true) @map("advisor_applications") // For admins
  platformNotifications  Boolean  @default(true) @map("platform_notifications")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_preferences")
}

model EmailLog {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailType   EmailType    @map("email_type")
  recipientEmail String    @map("recipient_email")
  subject     String

  // Email content
  templateId  String?      @map("template_id")
  variables   Json?        @default("{}")

  // Delivery status
  status      EmailStatus  @default(PENDING)
  sentAt      DateTime?    @map("sent_at")
  deliveredAt DateTime?    @map("delivered_at")
  openedAt    DateTime?    @map("opened_at")
  clickedAt   DateTime?    @map("clicked_at")

  // Error tracking
  errorMessage String?     @map("error_message") @db.Text
  retryCount   Int         @default(0) @map("retry_count")

  // Provider info
  provider     String?     // "sendgrid", "ses", "smtp"
  providerId   String?     @map("provider_id") // External message ID

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([userId])
  @@index([emailType])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("email_logs")
}

